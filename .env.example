# All relative paths resolve from the repository root.
AFDS_DATA_DIR=./data
AFDS_DATABASE_URL=sqlite:///./data/afds.db
AFDS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AFDS_FFMPEG=ffmpeg
AFDS_FFPROBE=ffprobe
AFDS_LEASE_SECONDS=30
AFDS_MEDIA_TIMEOUT=180
AFDS_MAX_JOB_ATTEMPTS=2
# Configure model URLs, keys and IDs in Studio > Model connections.
# Credentials are encrypted in the local data directory, which is excluded from Git.
