# Copy outside the repository; replace paths and immutable identities.
AFDS_RUNTIME_IMAGE=sha256:<built-runtime-image-id>
AFDS_WEB_IMAGE=sha256:<built-web-image-id>
AFDS_PUBLIC_ORIGIN=https://studio.example
AFDS_BIND_ADDRESS=127.0.0.1
AFDS_HTTPS_PORT=443
AFDS_SHARED_STORE=/srv/afds/data
AFDS_DATABASE_URL_SECRET=/srv/afds/private/database-url
AFDS_DATABASE_PASSWORD_SECRET=/srv/afds/private/database-password
AFDS_TLS_CERTIFICATE=/srv/afds/private/fullchain.pem
AFDS_TLS_PRIVATE_KEY=/srv/afds/private/privkey.pem
AFDS_INTERNAL_SUBNET=172.31.250.0/24
AFDS_PROXY_IP=172.31.250.10
# Optional dedicated trusted script controller; never mount its socket into API/media workers.
AFDS_SCRIPT_CONTROLLER_IMAGE=sha256:<built-controller-image-id>
AFDS_SANDBOX_IMAGE_ID=sha256:<approved-sandbox-image-id>
AFDS_SCRIPT_NODE_ID=scripts-1
AFDS_SCRIPT_CACHE=/srv/afds/script-cache
AFDS_DOCKER_SOCKET=/var/run/docker.sock
AFDS_DOCKER_GID=<host-socket-group-id>
AFDS_NETWORK=afds_internal
